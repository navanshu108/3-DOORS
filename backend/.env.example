# ==============================================================================
# Local-First Autonomous Research Agent - Backend Environment Configuration
# All operations default to on-device / local-only. Zero external cloud APIs required.
# ==============================================================================

# Application Environment (development | production | testing)
ENVIRONMENT=development
LOG_LEVEL=INFO

# Backend Server Configuration
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=false

# Allowed CORS Origins (JSON list or comma-separated string)
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:5173"]

# Ollama Local LLM Configuration
# Note: When running inside Docker, use http://host.docker.internal:11434 to reach the host Ollama instance
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:32b
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_TIMEOUT_SECONDS=120

# Vector Database (LanceDB Local Storage)
DATABASE_PATH=./data/vector_store
DOCUMENTS_PATH=./data/documents
CACHE_PATH=./data/cache

# Document Ingestion Settings
MAX_UPLOAD_SIZE_BYTES=52428800 # 50 MB
MAX_PDF_PAGES=500
MAX_EXTRACTED_CHARACTERS=5000000
ALLOWED_FILE_EXTENSIONS=[".pdf",".md",".txt",".markdown"]
CHUNK_SIZE=1000
CHUNK_OVERLAP=150

# RAG & Routing Thresholds
# If top chunk similarity is below this threshold, web research fallback triggers
RAG_CONFIDENCE_THRESHOLD=0.65
MAX_RETRIEVED_CHUNKS=5

# Autonomous Browser Agent (browser-use)
BROWSER_HEADLESS=true
BROWSER_TIMEOUT_SECONDS=60
MAX_BROWSER_STEPS=10
# Optional comma-separated or JSON domain allow-list. Empty allows public domains.
BROWSER_ALLOWED_DOMAINS=[]
