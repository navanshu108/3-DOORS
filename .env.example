# ==============================================================================
# Local-First Autonomous Research Agent - Root Environment Template
# ==============================================================================

# Backend API Configuration
API_HOST=0.0.0.0
API_PORT=8000
ENVIRONMENT=development

# Ollama Local LLM & Embeddings (Runs locally on host machine)
# When using Docker on Linux/macOS/Windows, use host.docker.internal:11434
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:32b
OLLAMA_EMBED_MODEL=nomic-embed-text

# Local Storage Paths (Local directory, zero cloud dependencies)
DATABASE_PATH=./data/vector_store
DOCUMENTS_PATH=./data/documents
CACHE_PATH=./data/cache
MAX_UPLOAD_SIZE_BYTES=52428800
BROWSER_TIMEOUT_SECONDS=60
BROWSER_MAX_STEPS=10
BROWSER_ALLOWED_DOMAINS=[]

# Frontend Configuration
VITE_API_BASE_URL=http://localhost:8000
